{
    "watch": [
        "index.js",
        "config",
        "routes",
        "controllers",
        "models",
        "migrations",
        "seeders",
        "backup",
        "db.js"
    ],
    "ext": "js,json,env",
    "ignore": [
        "node_modules",
        "logs",
        "public",
        "uploads"
    ],
    "exec": "node index.js",
    "env": {
        "NODE_ENV": "development"
    }
}